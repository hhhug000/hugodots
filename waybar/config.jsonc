{
    "position": "top",
    "margin_top": 40,                                                                                               

    /* ---------- Layout ---------- */
    "modules-left": [
        "clock",
        "tray"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "pulseaudio",
        "custom/notification",
        "temperature"
    ],

    /* ---------- Clock ---------- */
    "clock": {
        "interval": 60,
        "format": " {:%I:%M %p}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "max-length": 30
    },

    /* ---------- Workspaces ---------- */
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5,
            "HDMI-A-1": 3
        }
    },

    /* ---------- Tray ---------- */
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    /* ---------- Audio ---------- */
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pgrep -x pavucontrol > /dev/null && pkill -x pavucontrol || pavucontrol"
    },

    /* ---------- Network ---------- */
    "network": {
        "interface": "enp3s0",
        "format-ethernet": "  {ifname}",
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-disconnected": "",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) "
    },

    /* ---------- Temperature ---------- */
    "temperature": {
        "thermal-zone": 1,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },


    /* ---------- Notifications ---------- */
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none":         "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
